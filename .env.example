# ==============================================================================
# INVITEME CLIENT — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Hướng dẫn: Copy file này thành `.env.local` khi chạy local development:
#   cp .env.example .env.local
#
# QUY TẮC BẢO MẬT:
# - Không bao giờ commit file `.env.local` lên Git repository.
# - Mọi biến prefix `NEXT_PUBLIC_` sẽ được expose ra trình duyệt phía Client.
# - CI/CD pipeline sử dụng environment secrets hoặc default fallbacks, KHÔNG phụ thuộc .env.local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION BASE URL (Client & SEO Canonical, OpenGraph)
# ------------------------------------------------------------------------------
# Development: http://localhost:3000
# Staging:     https://staging.inviteme.vn
# Production:  https://inviteme.vn
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. BACKEND API ENDPOINT (REST API & Webhooks)
# ------------------------------------------------------------------------------
# Development: http://localhost:3001/api/v1
# Staging:     https://staging-api.inviteme.vn/api/v1
# Production:  https://api.inviteme.vn/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT MODE
# ------------------------------------------------------------------------------
# development | staging | production
NEXT_PUBLIC_ENVIRONMENT=development
